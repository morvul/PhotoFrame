<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PhotoFrame"
             x:Class="PhotoFrame.SensorPickerPage"
             Title="Выбор датчиков"
             BackgroundColor="#111111"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Заголовок -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="24,18" BackgroundColor="#1E1E1E">
            <Button Grid.Column="0"
                    Text="← Отмена"
                    Clicked="OnCancelClicked"
                    BackgroundColor="Transparent"
                    TextColor="#4FC3F7"
                    FontSize="18"
                    Padding="0" />

            <Label Grid.Column="1"
                   Text="Датчики Home Assistant"
                   TextColor="White"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="Готово"
                    Clicked="OnDoneClicked"
                    BackgroundColor="Transparent"
                    TextColor="#4FC3F7"
                    FontSize="18"
                    FontAttributes="Bold"
                    Padding="0" />
        </Grid>

        <!-- Состояние загрузки / ошибка -->
        <Label Grid.Row="1" x:Name="StatusLabel"
               TextColor="LightGray" FontSize="14"
               Padding="24,12" BackgroundColor="#181818"
               LineBreakMode="WordWrap" />

        <CollectionView Grid.Row="2" x:Name="SensorList" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:HomeAssistantSensor">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Padding="24,14" ColumnSpacing="10">

                        <!--
                            Номер в порядке показа. Стрелки рядом переставляют датчик
                            выше и ниже: порядок задаёт, как значения встанут на экране,
                            и раньше поменять его можно было только снятием отметок
                            и повторным выбором в нужной последовательности.
                        -->
                        <Label Grid.Column="0"
                               Text="{Binding OrderText}"
                               TextColor="#4FC3F7"
                               FontSize="15"
                               FontAttributes="Bold"
                               WidthRequest="22"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding DisplayName}" TextColor="White" FontSize="17" />
                            <Label Text="{Binding DetailText}" TextColor="Gray" FontSize="12"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding ValueWithUnit}"
                               TextColor="#4FC3F7"
                               FontSize="19"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />

                        <!-- Стрелки только у выбранных: невыбранному двигаться некуда. -->
                        <VerticalStackLayout Grid.Column="3"
                                             IsVisible="{Binding IsSelected}"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Button Text="▲"
                                    Clicked="OnMoveSensorUpClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#2A2A2A"
                                    TextColor="White"
                                    FontSize="13"
                                    Padding="0"
                                    WidthRequest="44"
                                    HeightRequest="26"
                                    CornerRadius="6" />
                            <Button Text="▼"
                                    Clicked="OnMoveSensorDownClicked"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="#2A2A2A"
                                    TextColor="White"
                                    FontSize="13"
                                    Padding="0"
                                    WidthRequest="44"
                                    HeightRequest="26"
                                    CornerRadius="6" />
                        </VerticalStackLayout>

                        <!-- Значок задаётся только у выбранного датчика. -->
                        <Button Grid.Column="4"
                                Text="{Binding IconButtonText}"
                                IsVisible="{Binding IsSelected}"
                                Clicked="OnPickIconClicked"
                                CommandParameter="{Binding .}"
                                BackgroundColor="#2A2A2A"
                                TextColor="White"
                                FontSize="20"
                                WidthRequest="54"
                                HeightRequest="54"
                                CornerRadius="12" />

                        <Button Grid.Column="5"
                                Text="{Binding SelectionGlyph}"
                                BackgroundColor="{Binding SelectionColor}"
                                Clicked="OnToggleSensorClicked"
                                CommandParameter="{Binding .}"
                                TextColor="Black"
                                FontAttributes="Bold"
                                FontSize="20"
                                WidthRequest="54"
                                HeightRequest="54"
                                CornerRadius="27" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="3" Padding="24,14" Spacing="4" BackgroundColor="#1E1E1E">
            <Label x:Name="SelectionSummaryLabel" TextColor="White" FontSize="15" />
            <!-- Выбранных датчиков может быть много, поэтому под перечень отдано три строки. -->
            <Label x:Name="SelectionDetailLabel" TextColor="Gray" FontSize="13"
                   LineBreakMode="WordWrap" MaxLines="3" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
