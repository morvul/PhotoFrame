<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PhotoFrame"
             x:Class="PhotoFrame.MainPage"
             BackgroundColor="Black"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- Слой слайд-шоу на весь экран. Aspect задаётся из настроек. -->
        <Image x:Name="SlideshowImage"
               Aspect="AspectFit"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <!--
            Проигрыватель видео. Показывается только на время воспроизведения, поверх
            заставки, которую в это время держит SlideshowImage.
        -->
        <local:VideoPlayerView x:Name="VideoPlayer"
                               IsVisible="False"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />

        <!--
            Слой касаний. Одиночное касание показывает панель управления, двойное
            переключает кадр: в левой половине — назад, в правой — вперёд.

            Фон не Transparent, а #01000000: на Android полностью прозрачный layout
            не участвует в hit-testing, и жесты до него не доходят.
        -->
        <Grid x:Name="TouchOverlay" BackgroundColor="#01000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
                <TapGestureRecognizer Tapped="OnScreenTapped" />
            </Grid.GestureRecognizers>
        </Grid>

        <!--
            Часы и дата. Метки с контуром собираются в code-behind: в XAML нет циклов,
            а обводка — это девять копий текста со смещением.
            Позиция меняется на каждом кадре, чтобы надпись не выжигалась в одном месте
            и не мешала всё время одному и тому же углу снимка.
        -->
        <VerticalStackLayout x:Name="ClockOverlay" Spacing="0" InputTransparent="True">
            <Grid x:Name="ClockTimeHost" InputTransparent="True" />
            <Grid x:Name="ClockDateHost" InputTransparent="True" Margin="4,-8,0,0" />
            <Grid x:Name="SensorHost" InputTransparent="True" Margin="4,4,0,0" />
        </VerticalStackLayout>

        <!--
            Чем и когда снят кадр. Приколочено к левому нижнему углу, а не привязано
            к часам: часы гуляют по углам, и подпись прыгала вместе с ними.
        -->
        <Grid x:Name="CaptureInfoHost"
              InputTransparent="True"
              HorizontalOptions="Start"
              VerticalOptions="End"
              Margin="26,0,0,14" />

        <!--
            Ночной режим: вместо слайд-шоу — крупные приглушённые часы на чёрном.
            InputTransparent, чтобы касание всё так же доходило до слоя жестов ниже
            и панель управления оставалась доступной.
        -->
        <Grid x:Name="NightOverlay"
              IsVisible="False"
              BackgroundColor="Black"
              InputTransparent="True">
            <!--
                Резервный вариант: обычные метки. Их закрывает NightClockImage, как только
                кадр с шахматной маской готов; если отрисовка почему-то не удалась,
                часы всё равно видны.
            -->
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                 Spacing="2" Opacity="0.32">
                <Label x:Name="NightTimeLabel"
                       TextColor="White"
                       FontSize="200"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="NightDateLabel"
                       TextColor="White"
                       FontSize="30"
                       HorizontalTextAlignment="Center"
                       Margin="0,-24,0,0" />
            </VerticalStackLayout>

            <!-- Часы на весь экран: горит только каждый второй пиксель. -->
            <Image x:Name="NightClockImage"
                   Aspect="Fill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   InputTransparent="True" />
        </Grid>

        <!--
            Управление видео. Кнопка воспроизведения по центру видна всегда, когда
            текущий кадр — видео: иначе о возможности воспроизвести никто не догадается.
            Повтор и звук — рядом, чтобы не прятать их в настройках.
        -->
        <VerticalStackLayout x:Name="VideoControls"
                             IsVisible="False"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="18">

            <Button x:Name="PlayPauseButton"
                    Text="▶"
                    Clicked="OnPlayPauseClicked"
                    BackgroundColor="#80000000"
                    TextColor="White"
                    FontSize="46"
                    WidthRequest="118"
                    HeightRequest="118"
                    CornerRadius="59"
                    HorizontalOptions="Center" />

            <!-- Позиция воспроизведения. Фон полупрозрачный, как у кнопок: поверх
                 светлого кадра тонкая полоска иначе не читается. -->
            <Border x:Name="VideoProgressPanel"
                    HorizontalOptions="Center"
                    Padding="18,12"
                    BackgroundColor="#80000000"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                      WidthRequest="520" RowSpacing="8" ColumnSpacing="12">
                    <ProgressBar Grid.Row="0" Grid.ColumnSpan="3"
                                 x:Name="VideoProgressBar"
                                 Progress="0"
                                 ProgressColor="#4FC3F7"
                                 BackgroundColor="#40FFFFFF"
                                 HeightRequest="6" />

                    <Label Grid.Row="1" Grid.Column="0"
                           x:Name="VideoPositionLabel"
                           Text="0:00"
                           TextColor="White"
                           FontSize="14" />

                    <Label Grid.Row="1" Grid.Column="2"
                           x:Name="VideoDurationLabel"
                           Text="0:00"
                           TextColor="#C0C0C0"
                           FontSize="14" />
                </Grid>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="16">
                <Button x:Name="RepeatButton"
                        Text="🔁"
                        Clicked="OnRepeatClicked"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontSize="24"
                        WidthRequest="68"
                        HeightRequest="68"
                        CornerRadius="34" />

                <Button x:Name="MuteButton"
                        Text="🔇"
                        Clicked="OnMuteClicked"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontSize="24"
                        WidthRequest="68"
                        HeightRequest="68"
                        CornerRadius="34" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!--
            Панель управления. По умолчанию скрыта и появляется по касанию экрана:
            обновление идёт само, кнопка нужна лишь чтобы не ждать очередной проверки.
        -->
        <Grid x:Name="ControlPanel"
              VerticalOptions="Start"
              ColumnDefinitions="*,Auto"
              Padding="20,16">

            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="8">
                <Button x:Name="SyncButton"
                        Text="Обновить фото"
                        Clicked="OnSyncClicked"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontAttributes="Bold"
                        Padding="20,10"
                        CornerRadius="10"/>

                <!-- Статус лежит поверх снимка, поэтому тоже с обводкой. -->
                <Grid x:Name="StatusHost" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Start">
                <Button x:Name="FileInfoButton"
                        Text="ℹ"
                        Clicked="OnFileInfoClicked"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontSize="22"
                        WidthRequest="56"
                        HeightRequest="56"
                        CornerRadius="28" />

                <!-- Убрать кадр из показа. Спрашивает подтверждение: соседняя кнопка —
                     настройки, и промах не должен стоить снимка. -->
                <Button x:Name="RemoveButton"
                        Text="🗑"
                        Clicked="OnRemoveClicked"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontSize="22"
                        WidthRequest="56"
                        HeightRequest="56"
                        CornerRadius="28" />

                <Button x:Name="SettingsButton"
                        Text="⚙"
                        Clicked="OnSettingsClicked"
                        BackgroundColor="#80000000"
                        TextColor="White"
                        FontSize="22"
                        WidthRequest="56"
                        HeightRequest="56"
                        CornerRadius="28" />
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
