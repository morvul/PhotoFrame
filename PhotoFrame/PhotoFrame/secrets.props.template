<!--
	Шаблон локальных настроек. Скопируйте этот файл рядом как "secrets.props" и заполните.
	secrets.props добавлен в .gitignore и в репозиторий не попадает.
-->
<Project>
	<PropertyGroup>
		<!--
			Ссылка на публично расшаренный альбом Google Photos.
			Google Photos -> альбом -> Поделиться -> Создать ссылку.
			Подходит и короткая (photos.app.goo.gl/...), и полная (photos.google.com/share/...).
		-->
		<GooglePhotosShareUrl></GooglePhotosShareUrl>

		<!--
			Home Assistant (необязательно) — показ значений датчиков поверх снимка.
			Внутренний адрес, а не внешний: рамке не нужен интернет, чтобы прочитать датчик.
			Settings -> System -> Network -> Home Assistant URL (Internal).
		-->
		<HomeAssistantBaseUrl></HomeAssistantBaseUrl>

		<!--
			Долгоживущий токен: профиль (внизу боковой панели) -> Security ->
			Long-lived access tokens -> Create token. Показывается только один раз.
			Токен даёт полный доступ к API Home Assistant, поэтому лежит здесь,
			а не в отслеживаемых файлах.
		-->
		<HomeAssistantToken></HomeAssistantToken>
	</PropertyGroup>
</Project>
